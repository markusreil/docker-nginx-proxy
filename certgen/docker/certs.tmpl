{{- /* certs.tmpl - renders the desired self-signed cert host set.

     Output format (consumed by on-change.sh -> lib.sh:read_desired):
       # certgen-desired v1        <- sentinel, must be the first line
       # containers-seen <N>       <- raw container count docker-gen saw
       <host>                     <- one exact VIRTUAL_HOST per line

     Only containers that opt in via GEN_SELF_SIGNED_CERT (true/1/t,
     case-insensitive) are considered.  Hosts are emitted verbatim (no
     wildcards, no parent-domain collapsing) because nginx-proxy probes
     /etc/nginx/certs/<host>.crt for the exact server name.  A hostname
     whitelist (regexMatch) rejects empty values, leading `*`/`~`, `:`, `/`,
     `..`, whitespace and other unsafe characters.  The containers-seen guard
     lets read_desired reject partial/empty renders.  parseBool is
     deliberately avoided: it errors on empty/unknown values and would abort
     the render.
     */ -}}
{{- $hosts := dict -}}
{{- $valid := `^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$` -}}
{{- range $c := $ -}}
  {{- $gate := toLower (trim (default "" $c.Env.GEN_SELF_SIGNED_CERT)) -}}
  {{- if or (eq $gate "true") (eq $gate "1") (eq $gate "t") -}}
    {{- range $host := splitList "," $c.Env.VIRTUAL_HOST -}}
      {{- $h := trim $host -}}
      {{- if regexMatch $valid $h -}}
        {{- $_ := set $hosts $h "" -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
# certgen-desired v1
# containers-seen {{ len $ }}
{{ range $h := sortAlpha (keys $hosts) }}{{ $h }}
{{ end -}}
