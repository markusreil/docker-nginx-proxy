# --- Global ---
# Which compose files make up the stack (variant selection).
#   LAN, self-signed TLS (default): docker-compose.yml:docker-compose.lan.yml
#   Internet, mandatory TLS:        docker-compose.yml:docker-compose.public.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.lan.yml
# Docker network name shared between the proxy and proxied containers
NGINX_PROXY_NETWORK=web-proxy
# --- nginx ---
# Base-image tag used to build the nginx image (a build arg, not an image: reference)
NGINX_PROXY_VERSION=1.11
# --- acme-companion ---
# acme-companion image version (upstream image IS the service per spec rule 6)
ACME_COMPANION_VERSION=2.8
# ACME contact email (Let's Encrypt); becomes the companion's DEFAULT_EMAIL.
# Required when COMPOSE_FILE selects the public variant.
ACME_EMAIL=
# --- certgen ---
# Self-signed certs are generated only for proxied containers that opt in via
# GEN_SELF_SIGNED_CERT (set that on the downstream container, not here).
# Self-signed cert validity in days
CERT_DAYS=825
# Seconds to wait before deleting a cert whose host stopped opting in
GEN_REMOVAL_GRACE=30
