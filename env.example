# Base domain; cert covers BASE_DOMAIN + *.BASE_DOMAIN
BASE_DOMAIN=localhost
# Cert validity in days
CERT_DAYS=825
# Docker network name shared between the proxy and proxied containers
NGINX_PROXY_NETWORK=web-proxy
# Optional contact email for Let's Encrypt (becomes the companion's DEFAULT_EMAIL). Leave empty for local-only use.
LE_EMAIL=
